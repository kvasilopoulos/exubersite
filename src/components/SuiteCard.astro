---
interface Props {
  name: string;
  lang: string;
  status: "core" | "stable" | "early" | "planned";
  description: string;
  install?: string;
  href: string;
}

const { name, lang, status, description, install, href } = Astro.props;

const statusStyle: Record<Props["status"], string> = {
  core: "text-ink border-border",
  stable: "text-stable border-stable/40",
  early: "text-threshold border-threshold/40",
  planned: "text-muted border-border border-dashed",
};
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  class="group flex flex-col gap-4 rounded-lg border border-border bg-panel p-6 transition-colors hover:border-muted focus-visible:border-muted"
>
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-display text-xl text-ink">{name}</h3>
      <p class="mt-0.5 font-mono text-[11px] uppercase tracking-wide text-muted">{lang}</p>
    </div>
    <span class={`shrink-0 rounded-full border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wide ${statusStyle[status]}`}>
      {status}
    </span>
  </div>

  <p class="text-sm leading-relaxed text-muted">{description}</p>

  {install && (
    <code class="mt-auto block truncate rounded border border-border bg-void px-3 py-2 font-mono text-[12px] text-ink/90">
      {install}
    </code>
  )}
</a>
