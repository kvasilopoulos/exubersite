---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Toc from "../components/Toc.astro";

export interface SidebarSection {
  title: string;
  items: { href: string; label: string }[];
}

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  headings?: MarkdownHeading[];
  sidebar: SidebarSection[];
}
const { title, description, eyebrow, headings = [], sidebar } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<Base title={`${title} — exuber`} description={description}>
  <Nav wide />
  <div
    class="mx-auto grid max-w-7xl gap-x-10 gap-y-8 px-6 py-10 lg:grid-cols-[13rem_minmax(0,1fr)] xl:grid-cols-[13rem_minmax(0,1fr)_13rem]"
  >
    <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-8rem)] lg:self-start lg:overflow-y-auto">
      {
        sidebar.map((section) => (
          <div class="mb-6 last:mb-0">
            <p class="mb-3 font-mono text-[11px] uppercase tracking-wide text-muted">
              {section.title}
            </p>
            <ul class="space-y-1 border-l border-border text-sm">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "-ml-px block border-l py-1 pl-3 leading-snug transition-colors hover:text-ink",
                      path === item.href.replace(/\/$/, "")
                        ? "border-explosive text-ink"
                        : "border-transparent text-muted",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </aside>

    <main id="main" class="min-w-0">
      {
        eyebrow && (
          <p class="font-mono text-xs uppercase tracking-widest text-explosive">{eyebrow}</p>
        )
      }
      <h1 class="mt-3 font-display text-3xl leading-tight text-ink sm:text-4xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">{description}</p>
      <div class="mt-10">
        <slot />
      </div>
    </main>

    <Toc headings={headings} />
  </div>
  <Footer />
</Base>
