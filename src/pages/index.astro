---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BubbleInstrument from "../components/BubbleInstrument.astro";
import SuiteCard from "../components/SuiteCard.astro";
import CodeTabs from "../components/CodeTabs.astro";
import Section from "../components/home/Section.astro";
import Story from "../components/home/Story.astro";
import Capabilities from "../components/home/Capabilities.astro";
import Grounding from "../components/home/Grounding.astro";
import Progress from "../components/home/Progress.astro";
import { suite, examples } from "../data/suite";
import { repo } from "../nav";

const badges = ["On CRAN", "JSS 2022", "30+ methods", "R · Python · C++"];
---

<Base
  title="exuber: testing for explosive dynamics"
  description="Tests for explosive time series in R, Python and C++. Detect bubbles, date them, monitor in real time, and allow for changing volatility or several markets. Each method is replicated against its source paper."
>
  <Nav />
  <main id="main" class="mx-auto max-w-5xl px-6">
    <section class="grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-explosive">Explosive time series</p>
        <h1 class="mt-4 font-display text-4xl leading-[1.1] text-ink sm:text-5xl">
          Detecting exuberance <em class="text-muted not-italic">before</em> the collapse.
        </h1>
        <p class="mt-6 text-base leading-relaxed text-muted">
          Test a series for a bubble, date the episode, and monitor it as it forms. The
          tests allow for changing volatility and work on a single series, a panel, or a
          whole market.
        </p>

        <div class="mt-8 space-y-1.5 rounded-lg border border-border bg-panel px-4 py-3 font-mono text-[13px] text-ink">
          <div><span class="inline-block w-16 select-none text-muted">R</span><span class="select-none text-muted">&gt; </span>install.packages("exuber")</div>
          <div><span class="inline-block w-16 select-none text-muted">Python</span><span class="select-none text-muted">$ </span>pip install pyexuber</div>
        </div>
        <p class="mt-2 font-mono text-[11px] text-muted">
          C++: <a href="/guide" class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive">from source</a>
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/guide" class="rounded-md bg-ink px-4 py-2 text-sm text-void transition-opacity hover:opacity-85">Get started</a>
          <a href={repo} class="rounded-md border border-border px-4 py-2 text-sm text-ink transition-colors hover:border-muted">GitHub</a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-2">
          {badges.map((b) => (
            <li class="rounded-full border border-border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wide text-muted">{b}</li>
          ))}
        </ul>
      </div>

      <div class="rounded-xl border border-border bg-panel/60 p-5 sm:p-6">
        <BubbleInstrument />
      </div>
    </section>

    <Section
      id="suite"
      eyebrow="01 · get started"
      title="One core, three ways in."
      lead="The costly part of a GSADF run is a recursive least-squares fit, updated with the Sherman-Morrison formula and repeated over O(T²) windows. It is written once, in C++. Each language binding wraps that core and adds the tools that users of that language expect."
    >
      <div class="grid gap-4 sm:grid-cols-3">
        {suite.map((s) => <SuiteCard {...s} />)}
      </div>

      <div class="mt-14">
        <p class="font-mono text-xs uppercase tracking-widest text-muted">The same run</p>
        <h3 class="mt-4 font-display text-xl text-ink">Three languages, one statistic.</h3>
        <p class="mt-4 mb-6 text-sm leading-relaxed text-muted">
          The example simulates a series, tests it, calibrates the critical values and
          date-stamps the result. The R and Python versions differ only in spelling. The
          C++ core stops at the statistic, because anything that needs random numbers
          stays in the host language.
        </p>
        <CodeTabs tabs={examples} />
        <p class="mt-6 text-sm leading-relaxed text-muted">
          Install steps for each language are in the
          <a href="/guide" class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive">getting-started guide</a>.
          Every function is listed in the <a href="/reference" class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive">reference index</a>.
        </p>
      </div>
    </Section>

    <Story />
    <Capabilities />
    <Grounding />
    <Progress />
  </main>
  <Footer />
</Base>
