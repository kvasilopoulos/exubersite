---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BubbleInstrument from "../components/BubbleInstrument.astro";
import SuiteCard from "../components/SuiteCard.astro";
import CodeTabs from "../components/CodeTabs.astro";
import Section from "../components/home/Section.astro";
import Story from "../components/home/Story.astro";
import Capabilities from "../components/home/Capabilities.astro";
import Grounding from "../components/home/Grounding.astro";
import Progress from "../components/home/Progress.astro";

const suite = [
  {
    name: "exubercore",
    lang: "C++ / Armadillo",
    status: "core" as const,
    description: "The recursive least-squares statistic itself. No R or Python dependency — plain matrices in, a statistic out. Everything RNG-driven (simulation, bootstrap, date-stamping) stays in the host language for now.",
    href: "https://github.com/kvasilopoulos/exubercore",
  },
  {
    name: "exuber",
    lang: "R · on CRAN",
    status: "stable" as const,
    description: "The full surface: the statistic, Monte Carlo and wild-bootstrap critical values, date-stamping, plotting, and panel methods.",
    install: 'install.packages("exuber")',
    href: "https://github.com/kvasilopoulos/exuber",
  },
  {
    name: "pyexuber",
    lang: "Python · pybind11",
    status: "early" as const,
    description: "Bindings onto the same core, imported as exuber, with the R surface ported method by method — tests, bootstraps, dating, monitoring, multivariate, simulation — and cross-checked against R.",
    install: "git clone …exuber/pyexuber && uv sync --dev",
    href: "https://github.com/kvasilopoulos/pyexuber",
  },
];

const examples = [
  {
    label: "R",
    lang: "r",
    code: `library(exuber)

rsim <- radf(sim_data)               # adf, badf, sadf, gsadf, bsadf, ...
cv <- radf_mc_cv(n = NROW(sim_data)) # simulated 90/95/99% thresholds

summary(rsim, cv)   # rejects/does not reject H0 per series, per statistic
autoplot(rsim, cv)  # bsadf vs. its threshold, explosive spans shaded
datestamp(rsim, cv) # a Start/End/Duration row per detected episode`,
  },
  {
    label: "Python",
    lang: "python",
    code: `import numpy as np
import exuber

data = np.cumsum(np.random.randn(200))
result = exuber.radf(data)          # RadfResult: .adf .badf .sadf .gsadf .bsadf
cv = exuber.radf_mc_cv(n=len(data)) # RadfCv: simulated 90/95/99% thresholds

result.adf, result.sadf, result.gsadf
exuber.datestamp(result, cv)  # list[Episode]: one per detected explosive span`,
  },
  {
    label: "C++",
    lang: "cpp",
    code: `#include <exubercore/radf.hpp>

arma::vec y = arma::cumsum(arma::randn(200));
auto result = exubercore::radf(y, /* min_win = */ 20);
// arma::vec: badf, then adf, sadf, gsadf, then the bsadf sequence --
// see the reference entry for the exact layout and offsets.`,
  },
];

const teasers = [
  {
    href: "/guide",
    eyebrow: "The method",
    title: "Four tests, one recursion.",
    body: "ADF, SADF, GSADF, and BSADF — how a floating window catches bubbles a fixed one misses, what minw and lag control, and how thresholds get simulated rather than looked up.",
  },
  {
    href: "/reference",
    eyebrow: "The reference",
    title: "Every function, natively.",
    body: "Arguments, return values, and worked examples for the full R surface, plus Python and C++ — rendered directly from the package's own documentation.",
  },
  {
    href: "/replication",
    eyebrow: "The replication record",
    title: "What was reproduced, and how.",
    body: "Every method beyond the original PSY test, independently re-derived by a standalone script — including the bugs those scripts found.",
  },
];

const sections = [
  { href: "#story", label: "Story" },
  { href: "#capabilities", label: "Capabilities" },
  { href: "#evidence", label: "Academic grounding" },
  { href: "#progress", label: "Progress" },
  { href: "#suite", label: "Get started" },
];
---

<Base
  title="exuber — testing for explosive dynamics"
  description="The toolkit for explosive time series: bubble tests, date-stamping, real-time monitoring, volatility-robust and multivariate methods — each replicated against its source paper, in R, Python and C++."
>
  <Nav />
  <main id="main" class="mx-auto max-w-5xl px-6">
    <section class="py-16 sm:py-24">
      <p class="font-mono text-xs uppercase tracking-widest text-explosive">Explosive time series</p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl leading-[1.1] text-ink sm:text-5xl">
        Detecting exuberance <em class="text-muted not-italic">before</em> the collapse.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">
        The toolkit for explosive time series: test for bubbles, date them, monitor them as
        they form, and check the answer survives time-varying volatility — for single
        series, panels and whole markets.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#suite" class="rounded-md bg-ink px-4 py-2 text-sm text-void transition-opacity hover:opacity-85">Get started</a>
        <a href="/guide" class="rounded-md border border-border px-4 py-2 text-sm text-ink transition-colors hover:border-muted">Read the method</a>
        <span class="font-mono text-[11px] uppercase tracking-wide text-muted">30+ methods · 52 papers · peer-reviewed in JSS · R · Python · C++</span>
      </div>

      <div class="mt-14 rounded-xl border border-border bg-panel/60 p-6 sm:p-8">
        <BubbleInstrument />
      </div>

      <nav aria-label="On this page" class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-wide text-muted">
        {sections.map((l, i) => (
          <a href={l.href} class="transition-colors hover:text-ink">{`0${i + 1} ${l.label}`}</a>
        ))}
      </nav>
    </section>

    <Story />
    <Capabilities />
    <Grounding />
    <Progress />

    <Section
      id="suite"
      eyebrow="05 — get started"
      title="One core. Three ways in."
      lead="The expensive part of a GSADF run — a Sherman-Morrison-updated recursive least squares, repeated across O(T²) windows — lives once, in C++. Each language binding wraps that core and adds whatever that ecosystem's users actually need on top of it."
    >
      <div class="grid gap-4 sm:grid-cols-3">
        {suite.map((s) => <SuiteCard {...s} />)}
      </div>

      <div class="mt-14">
        <p class="font-mono text-xs uppercase tracking-widest text-muted">The same run</p>
        <h3 class="mt-4 font-display text-xl text-ink">Three languages, one statistic.</h3>
        <p class="mt-4 mb-6 text-sm leading-relaxed text-muted">
          Simulate, test, calibrate, date-stamp. The R and Python paths differ only in
          spelling; the C++ core stops at the statistic, because everything RNG-driven
          stays in the host language.
        </p>
        <CodeTabs tabs={examples} />
        <p class="mt-6 text-sm leading-relaxed text-muted">
          Python accepts a numpy array, a 1-D sequence, or anything exposing
          <code class="text-ink">.to_numpy()</code> (pandas/polars) — neither is a hard dependency.
          C++ requires a system Armadillo with BLAS/LAPACK; build with CMake, link, done.
          The full surface of each is in the <a href="/reference" class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive">reference index</a>.
        </p>
      </div>
    </Section>

    <section class="border-t border-border py-16 sm:py-20">
      <p class="font-mono text-xs uppercase tracking-widest text-explosive">06 — go deeper</p>
      <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3">
      {teasers.map((t) => (
        <a href={t.href} class="group flex flex-col gap-3 bg-panel p-7 transition-colors hover:bg-panel-hi">
          <span class="font-mono text-[11px] uppercase tracking-wide text-muted">{t.eyebrow}</span>
          <h3 class="font-display text-xl text-ink">{t.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{t.body}</p>
          <span class="mt-1 font-mono text-[11px] uppercase tracking-wide text-ink opacity-0 transition-opacity group-hover:opacity-100">
            Read more →
          </span>
        </a>
      ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
