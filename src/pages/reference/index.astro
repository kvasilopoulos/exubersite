---
import DocsLayout from "../../layouts/DocsLayout.astro";
import reference from "../../data/reference.json";
import extra from "../../data/reference-extra.json";
import { replicationSection, referenceSection, slugify } from "../../sidebars";

const headings = [
  ...reference.r.map((g) => ({ depth: 2, slug: slugify(g.title), text: g.title })),
  { depth: 2, slug: "python", text: "Python — pyexuber" },
  { depth: 2, slug: "cpp", text: "C++ — exubercore" },
];

const total = reference.r.reduce((n, g) => n + g.entries.length, 0);
const sidebar = [referenceSection(), await replicationSection()];
const topicPages: Record<string, unknown> = reference.topics;
---

<DocsLayout
  eyebrow="Packages"
  title="Reference index"
  description={`Every documented entry point across the three implementations — ${total} R topics grouped as in the package's own reference index, plus the Python and C++ surfaces.`}
  headings={headings}
  sidebar={sidebar}
>
  <section class="prose">
    <p>
      Grouping and descriptions come straight from <code>exuber</code>'s
      <code>_pkgdown.yml</code>, so this index cannot drift from the package's own. Each row
      opens its full documentation — arguments, return value, worked examples — rendered
      natively on this site, parsed directly from the package's own <code>.Rd</code> files.
      Groups that came out of the replication research link back to the family page that
      motivated them.
    </p>
    <p class="mt-4">
      Naming follows what a function actually computes, not just which paper it came from.
      <code>radf_</code> is reserved for functions genuinely built on the recursive-ADF core —
      they call <code>radf()</code> directly or reuse its <code>badf</code>/<code>bsadf</code>
      output (<code>radf_tt()</code>, <code>radf_sign()</code>, and the <code>_cv</code>/
      <code>_mc</code> critical-value engines). Everything else is named for what it does instead
      of borrowed prefix: a <code>_test</code> suffix is a hypothesis test with its own null
      distribution (<code>lbi_test()</code>, <code>ssu_test()</code>, <code>quantile_test()</code>,
      <code>cobubble_test()</code>); a <code>dating_</code> prefix is a point-estimation /
      model-selection procedure with no formal test at all (<code>dating_hls()</code>,
      <code>dating_hlw()</code>, <code>dating_knp()</code>, <code>dating_pdc()</code>); a
      <code>monitor_</code> prefix is real-time/sequential detection (<code>monitor_cusum()</code>,
      <code>monitor_lbi()</code>, <code>monitor_quantile()</code>, and <code>monitor_radf()</code>
      — grouped with its fellow monitors deliberately, even though it reuses <code>radf()</code>'s
      own <code>badf</code>/<code>bsadf</code> internals, since "what monitors in real time" is
      what a reader searching that prefix actually wants); a <code>root_</code> prefix is
      confidence-interval inference on the <em>magnitude</em> of the explosive autoregressive root
      itself, not a test for its presence (<code>rootstamp()</code>, via two S3 methods — default
      for a single sub-sample, <code>radf_obj</code> to run every <code>datestamp()</code> episode
      at once); and <code>contagion_reg()</code> stands on its own as a
      point-estimation tool that performs no formal inference at all. Naming is a guide, not a
      contract — for anything programmatic, call <code>exuber_functions(family = ...)</code>
      instead of parsing names.
    </p>
    <p class="mt-4">
      Don't confuse the standalone <code>dating_</code> family above with
      <a href="/reference/datestamp"><code>datestamp()</code></a> in the Analysis group below —
      <code>datestamp()</code> is PSY's own threshold-crossing rule, a generic dispatched on any
      <code>radf_obj</code> + <code>radf_cv</code> pair; the <code>dating_</code> functions are
      unrelated SSR/BIC dating procedures called directly on raw data, with no critical value
      involved at all.
    </p>
    <p class="mt-4">
      Only results that carry the <code>radf_obj</code> class can be passed to the shared
      Analysis/Tidying/Plotting generics below (<code>summary()</code>, <code>datestamp()</code>,
      <code>tidy()</code>, <code>autoplot()</code>) — everything else prints its own way, in a
      shape that generic table doesn't fit. <code>radf_common()</code> and <code>radf_kp()</code>
      return <code>radf()</code>'s own output unmodified and so support the full set.
      <code>radf_sign()</code>/<code>radf_sign_dm()</code>/<code>radf_tt()</code> carry the class
      too, but only <code>summary()</code>/<code>tidy()</code> currently work — their own
      <code>_cv()</code> functions compute just the three scalar critical values
      <code>summary()</code> needs, not the time-varying boundary <code>datestamp()</code>/
      <code>autoplot()</code> require, a known gap. See <code>vignette("naming-and-analysis",
      package = "exuber")</code> for the full picture with worked examples.
    </p>
  </section>

  <div class="mt-10 space-y-12">
    {
      reference.r.map((group) => (
        <section>
          <div class="border-b border-border pb-3">
            <h2 id={slugify(group.title)} class="scroll-mt-24 font-display text-xl text-ink">
              {group.title}
            </h2>
            {group.desc && <p class="mt-1.5 text-sm leading-relaxed text-muted">{group.desc}</p>}
            {group.replication && (
              <a
                href={`/replication/${group.replication}`}
                class="mt-2 inline-block font-mono text-[11px] uppercase tracking-wide text-explosive underline decoration-border underline-offset-4 hover:decoration-explosive"
              >
                Replication record →
              </a>
            )}
          </div>
          <ul class="mt-1 divide-y divide-border">
            {group.entries.map((e) => (
              <li>
                {topicPages[e.topic] ? (
                  <a
                    href={`/reference/${e.topic}`}
                    class="grid gap-1 py-2.5 transition-colors hover:bg-panel sm:grid-cols-[15rem_minmax(0,1fr)] sm:gap-4"
                  >
                    <code class="font-mono text-[13px] text-ink">{e.name}()</code>
                    <span class="text-sm leading-snug text-muted">{e.title}</span>
                  </a>
                ) : (
                  <span class="grid gap-1 py-2.5 sm:grid-cols-[15rem_minmax(0,1fr)] sm:gap-4">
                    <code class="font-mono text-[13px] text-ink">{e.name}()</code>
                    <span class="text-sm leading-snug text-muted">{e.title}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      [
        { id: "python", label: "Python", data: extra.python },
        { id: "cpp", label: "C++", data: extra.cpp },
      ].map(({ id, label, data }) => (
        <section>
          <div class="border-b border-border pb-3">
            <h2 id={id} class="scroll-mt-24 font-display text-xl text-ink">
              {label} — {data.package}
            </h2>
            <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">{data.note}</p>
            <a
              href={data.repo}
              class="mt-2 inline-block font-mono text-[11px] uppercase tracking-wide text-muted underline decoration-border underline-offset-4 hover:text-ink"
            >
              {data.repo.replace("https://github.com/", "")} →
            </a>
          </div>
          {data.groups.map((group) => (
            <div class="mt-6">
              <p class="font-mono text-[11px] uppercase tracking-wide text-muted">{group.title}</p>
              <ul class="mt-1 divide-y divide-border">
                {group.entries.map((e) => (
                  <li class="grid gap-1 py-2.5 sm:grid-cols-[15rem_minmax(0,1fr)] sm:gap-4">
                    <code class="font-mono text-[13px] break-words text-ink">{e.name}</code>
                    <span class="text-sm leading-snug text-muted">{e.title}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>

  {
    reference.ungrouped.length > 0 && (
      <p class="mt-14 border-t border-border pt-6 text-xs leading-relaxed text-muted">
        <span class="font-mono uppercase tracking-wide">Not indexed</span> — {reference.ungrouped.length}{" "}
        exports are documented under an aliased topic and so carry no row of their own:{" "}
        {reference.ungrouped.map((n) => (
          <code class="font-mono">{n} </code>
        ))}
      </p>
    )
  }
</DocsLayout>
