---
import { getCollection, render } from "astro:content";
import { Code } from "astro:components";
import DocsLayout from "../../layouts/DocsLayout.astro";
import manifest from "../../data/replication-scripts.json";
import { replicationSection } from "../../sidebars";

export async function getStaticPaths() {
  const pages = await getCollection("replication");
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const sidebar = [await replicationSection()];
const guidePage = (await getCollection("guide")).find((g) => g.data.family === page.id);

// Vite reads the vendored .R/.py files at build time. The markdown links to
// the R scripts as #script-<name> anchors (Python: #script-<name>-py), so the
// scripts are rendered below the prose.
const sources = import.meta.glob<string>("../../replication-code/*.{R,py}", {
  query: "?raw",
  import: "default",
  eager: true,
});

const scripts = manifest
  .filter((s) => s.family === page.id)
  .map((s) => ({ ...s, code: sources[`../../replication-code/${s.file}`] ?? "" }))
  .sort((a, b) => a.name.localeCompare(b.name) || (a.lang === "r" ? -1 : 1));
const nPy = scripts.filter((s) => s.lang === "python").length;
---

<DocsLayout
  eyebrow="Replication"
  title={page.data.title}
  description={page.data.blurb}
  headings={headings}
  sidebar={sidebar}
>
  {
    guidePage && (
      <p class="mb-8 rounded-lg border border-border bg-panel px-4 py-3 text-sm leading-relaxed text-muted">
        This page is the technical record behind the methods. To learn how to run them, start with{" "}
        <a class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive" href={`/guide/${guidePage.id}`}>
          {guidePage.data.title}
        </a>{" "}
        in the guide.
      </p>
    )
  }
  <article class="prose">
    <Content />
  </article>

  {
    scripts.length > 0 && (
      <section class="mt-16 border-t border-border pt-10">
        <h2 class="font-display text-2xl text-ink">Replication scripts</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
          {scripts.length} standalone {scripts.length === 1 ? "script supports" : "scripts support"}
          the claims above, and none depends on another. The R scripts run from the{" "}
          <code class="font-mono">exuber/</code> package root{nPy > 0 && <>. The {nPy} Python {nPy === 1 ? "script checks" : "scripts check"} that pyexuber reproduces the same numbers</>}.
        </p>
        <div class="mt-6 space-y-3">
          {scripts.map((s) => (
            <details id={s.lang === "r" ? `script-${s.name}` : `script-${s.name}-py`} class="rounded-lg border border-border bg-panel">
              <summary class="cursor-pointer px-4 py-3 font-mono text-xs text-ink marker:text-muted">
                {s.file}
                <span class="ml-2 text-muted">
                  {s.code.split("\n").length} lines
                </span>
              </summary>
              <div class="code-block border-t border-border">
                <Code theme="github-light" code={s.code} lang={s.lang as "r" | "python"} />
              </div>
            </details>
          ))}
        </div>
      </section>
    )
  }
</DocsLayout>

<style>
  details > div :global(pre.astro-code) {
    border: 0;
    border-radius: 0;
    margin: 0;
  }
</style>

<script>
  // A link to #script-x in the prose must open the collapsed block.
  const openTarget = () => {
    const el = location.hash && document.querySelector(location.hash);
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView();
    }
  };
  openTarget();
  window.addEventListener("hashchange", openTarget);
</script>
