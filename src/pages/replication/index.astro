---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import scripts from "../../data/replication-scripts.json";
import table from "../../data/replication-table.json";
import reference from "../../data/reference.json";
import { replicationSection } from "../../sidebars";

const pages = (await getCollection("replication")).sort((a, b) => a.data.order - b.data.order);
const sidebar = [await replicationSection()];
const topics: Record<string, unknown> = reference.topics;

const families = pages
  .map((p) => ({ id: p.id, title: p.data.title, rows: table.filter((r) => r.family === p.id) }))
  .filter((f) => f.rows.length > 0);

const counts = {
  clean: table.filter((r) => r.kind === "clean").length,
  fixed: table.filter((r) => r.kind === "fixed").length,
  caveat: table.filter((r) => r.kind === "caveat").length,
};

const chip: Record<string, string> = {
  clean: "text-stable border-stable/40",
  fixed: "text-explosive border-explosive/40",
  caveat: "text-threshold border-threshold/40",
};
const link = "text-ink underline decoration-border underline-offset-4 hover:decoration-explosive";
---

<DocsLayout
  eyebrow="The replication record"
  title="Replication"
  description="Every method that exuber implements beyond the original PSY test was taken from its primary source, implemented, and then re-derived independently by a standalone script. This page records what was reproduced, how, and where the result fell short."
  sidebar={sidebar}
>
  <section class="max-w-2xl space-y-4 text-sm leading-relaxed text-muted">
    <p>
      This section is for readers who want to check the work. If you want to run the methods on
      your own data, the <a href="/guide" class="text-ink underline decoration-border underline-offset-4 hover:decoration-explosive">guide</a>
      is the better place to start.
    </p>
    <p>
      The package's own tests guard against regressions. The {scripts.length} scripts behind this
      page re-derive each statistic from scratch, using brute-force regressions, hand-derived
      identities, and Monte Carlo size and power compared with the paper's tables. Agreement
      therefore means something independent of the code being checked. Where a script found a
      bug, the bug is recorded on this page.
    </p>
    <p>
      Of the {table.length} methods, <span class="text-stable">{counts.clean} are clean</span>,
      <span class="text-explosive">{counts.fixed} had a bug that was found and fixed</span>, and
      <span class="text-threshold">{counts.caveat} shipped with a caveat</span>. Every script is
      self-contained. The R scripts run from the <code class="font-mono text-ink">exuber/</code>
      package root, and the Python versions check that pyexuber reproduces the same numbers.
    </p>
  </section>

  <div class="mt-12 space-y-12">
    {families.map((f) => (
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-border pb-3">
          <h2 id={f.id} class="scroll-mt-24 font-display text-xl text-ink">{f.title}</h2>
          <a href={`/replication/${f.id}`} class="font-mono text-[11px] uppercase tracking-wide text-muted transition-colors hover:text-ink">
            Full notes &amp; scripts →
          </a>
        </div>
        <ul class="divide-y divide-border">
          {f.rows.map((r) => (
            <li class="grid gap-x-6 gap-y-1.5 py-3.5 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)_minmax(0,0.9fr)]">
              <div>
                <p class="text-sm leading-snug text-ink">{r.item}</p>
                {topics[r.fn] && (
                  <a href={`/reference/${r.fn}`} class="font-mono text-[12px] text-stable hover:underline">{r.fn}()</a>
                )}
              </div>
              <p class="text-[13px] leading-snug text-muted">{r.check || "Unit tests"}</p>
              <div>
                <span class={`inline-block rounded-full border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide ${chip[r.kind]}`}>{r.verdict}</span>
                {r.kind !== "clean" && r.detail && <p class="mt-1.5 text-xs leading-snug text-muted">{r.detail}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="mt-16 border-t border-border pt-10">
    <h2 id="notes" class="scroll-mt-24 font-display text-xl text-ink">Full research notes</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
      These are the working notes behind the table, with one page for each family. Each page lists
      the sources, the exact numbers reproduced, what was simplified, what remains open, and every
      script in full.
    </p>
    <ul class="mt-6 divide-y divide-border border-y border-border">
      {pages.map((p) => (
        <li>
          <a href={`/replication/${p.id}`} class="grid gap-1 py-3 transition-colors hover:bg-panel sm:grid-cols-[16rem_minmax(0,1fr)] sm:gap-4">
            <span class="text-sm text-ink">{p.data.title}</span>
            <span class="text-sm leading-snug text-muted">{p.data.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs leading-relaxed text-muted">
      The cited PDFs are not redistributed here. The <a href="/replication/references" class={link}>bibliography</a>
      gives DOIs and working-paper links instead.
    </p>
  </section>
</DocsLayout>
